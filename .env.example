# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django SuperUser (used only on first init)
# If you expose the app to your local network,
# change the password after the first login (Admin → Users → admin).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass

# Database (PostgreSQL)
# Note: these are used only on first init. Changing DB_PASSWORD after the
# volume is created has no effect. Reset with:
#   docker compose down -v
DB_NAME=midgard_nexus
DB_USER=admin
DB_PASSWORD=admin

# Nginx
NGINX_PORT=80
